[Version]
Signature   = "$WINDOWS NT$"
Class       = SoftwareComponent
ClassGuid   = {5c4c3332-344d-483c-8739-259e934c9cc8}
Provider    = %Realtek%
DriverVer   = 11/02/2022,11.0.6000.1
CatalogFile = AcerPurifiedVoiceHSA.cat
PnpLockDown=1

[SourceDisksNames]
222 = %DiskId1%

[SourceDisksFiles]

[DestinationDirs]

[SignatureAttributes]

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%Realtek% = HsaComponents,NTamd64

[HsaComponents.NTamd64]
%Hsa.ComponentDesc% = HsaComponent_Install,SWC\VEN_10EC&HID_0101

[HsaComponent_Install]
Include   = wdmaudio.inf

[HsaComponent_Install.Services]
AddService = ,2    ; no function driver

[HsaComponent_Install.Software]
AddSoftware=AcerPurifiedVoiceConsole,,AcerPurifiedVoiceConsole_Install

[AcerPurifiedVoiceConsole_Install]
SoftwareType=2
SoftwareID=pfn://AcerIncorporated.AcerPurifiedVoiceConsoleR_48frkmn4z8aw4

[Strings]
Realtek           = "Realtek"
Hsa.ComponentDesc = "Acer Purified Voice Application"
DiskId1           = "Acer HSA Installation Disk"

REG_BINARY = 0x00000001
REG_DWORD = 0x00010001
REG_MULTI_SZ = 0x00010000
